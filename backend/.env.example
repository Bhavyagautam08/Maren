# Backend Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=5000

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_jwt_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here

# CORS - Frontend origins (comma-separated for multiple Vercel deployments)
CLIENT_URL=http://localhost:3000
# CLIENT_URLS=https://your-production-frontend.vercel.app,https://your-preview-frontend.vercel.app

# Email (Gmail SMTP - use an App Password, not your real password)
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password

# Upstash REST credentials (copy from the Upstash console; never commit real values)
REDIS_ENABLED=true
UPSTASH_REDIS_REST_URL=https://<your-database>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-upstash-rest-token>
# Optional product-list benchmark controls; defaults preserve caching behavior.
DISABLE_PRODUCT_CACHE=false
PRODUCT_CACHE_NAMESPACE=

# Benchmark cluster URI; the suite selects BENCHMARK_DB_NAME as its database.
# Use a separate database containing "benchmark", never the app database.
BENCHMARK_MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ecommerce_db?retryWrites=true&w=majority
BENCHMARK_DB_NAME=maren_benchmark
