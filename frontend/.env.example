# Frontend Environment Variables
# Copy this file to .env.local and fill in your values

# Backend API URL
# For local dev: http://localhost:5000/api/v1
# For production: your backend URL, with or without the /api/v1 suffix
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Public throwaway credentials for the recruiter demo account.
# Use the same values as DEMO_ACCOUNT_EMAIL and DEMO_ACCOUNT_PASSWORD in backend/.env.
NEXT_PUBLIC_DEMO_EMAIL=demo@maren.example
NEXT_PUBLIC_DEMO_PASSWORD=replace-with-a-throwaway-password
